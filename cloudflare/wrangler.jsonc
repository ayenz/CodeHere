// The editor: static client + one Durable Object per room. Deployed to codehere.<account>.workers.dev.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "codehere",
  "main": "src/editor.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    // The Worker decides: every non-asset path is a room and gets index.html.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Registry"] }],
  // New WebSocket connections per client IP per minute (per Cloudflare location). Protects the
  // free plan's daily Durable Object quota from connect/close floods.
  // Generous enough for a classroom or office sharing one public IP.
  "ratelimits": [{ "name": "CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // Demo limits (0 = unlimited). Tuned to stay well inside the Workers Free plan.
  "vars": {
    "MAX_DOC_CHARS": "100000",
    "MAX_MESSAGE_BYTES": "1048576",
    "MAX_CONNECTIONS_PER_ROOM": "50",
    "MAX_NEW_ROOMS_PER_HOUR": "30",
    "ROOM_TTL_DAYS": "7"
  },
  "observability": { "enabled": true }
}
