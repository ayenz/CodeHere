# HTTP / WebSocket server
PORT=3000
HOST=0.0.0.0

# Database: sqlite | mysql | postgres
DB_DRIVER=sqlite
# Used when DB_DRIVER=sqlite
SQLITE_PATH=./data/codehere.db
# Used when DB_DRIVER=mysql or postgres, e.g.
#   mysql://user:pass@localhost:3306/codehere
#   postgres://user:pass@localhost:5432/codehere
DATABASE_URL=

# Admin page, served only on its own host. Both must be set to enable it.
# In development use admin.localhost (open http://admin.localhost:5173).
ADMIN_PASSWORD=
ADMIN_HOST=admin.localhost
# Public URL of the editor, for links from the admin page. Defaults to ADMIN_HOST
# without its first label (admin.example.com -> example.com).
PUBLIC_URL=

# Set to true only behind a reverse proxy you control, so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# Delete rooms not edited for this many days (0 = keep forever)
ROOM_TTL_DAYS=0
# Delay before writing a changed document to the database
PERSIST_DEBOUNCE_MS=2000

# Limits. Every limit is off (0) by default.
# Maximum characters in one room
MAX_DOC_CHARS=0
# Maximum size of one WebSocket message in bytes
MAX_MESSAGE_BYTES=0
# Sustained WebSocket messages per second per connection (bursts up to 4x)
MAX_MESSAGES_PER_SECOND=0
# Simultaneous connections per client IP
MAX_CONNECTIONS_PER_IP=0
# New rooms a client IP may create per hour
MAX_NEW_ROOMS_PER_HOUR=0
# Rooms kept in memory at once
MAX_ACTIVE_ROOMS=0
